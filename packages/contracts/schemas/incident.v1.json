{
  "$defs": {
    "IncidentStatus": {
      "enum": [
        "OPEN",
        "TRIAGING",
        "INVESTIGATING",
        "AWAITING_APPROVAL",
        "REMEDIATING",
        "VERIFYING",
        "RESOLVED",
        "NEEDS_HUMAN",
        "REJECTED",
        "FAILED"
      ],
      "title": "IncidentStatus",
      "type": "string"
    },
    "Severity": {
      "enum": [
        "critical",
        "high",
        "warning",
        "info"
      ],
      "title": "Severity",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "environment": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:/-]+$",
      "title": "Environment",
      "type": "string"
    },
    "fingerprint": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:/-]+$",
      "title": "Fingerprint",
      "type": "string"
    },
    "first_seen": {
      "format": "date-time",
      "title": "First Seen",
      "type": "string"
    },
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "last_seen": {
      "format": "date-time",
      "title": "Last Seen",
      "type": "string"
    },
    "service": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:/-]+$",
      "title": "Service",
      "type": "string"
    },
    "severity": {
      "$ref": "#/$defs/Severity"
    },
    "status": {
      "$ref": "#/$defs/IncidentStatus"
    },
    "summary": {
      "default": "",
      "maxLength": 2000,
      "title": "Summary",
      "type": "string"
    },
    "version": {
      "default": 0,
      "description": "Optimistic-lock version",
      "minimum": 0,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "id",
    "fingerprint",
    "status",
    "severity",
    "service",
    "environment",
    "first_seen",
    "last_seen"
  ],
  "title": "Incident",
  "type": "object"
}
