{
  "$defs": {
    "IncidentStatus": {
      "enum": [
        "OPEN",
        "TRIAGING",
        "INVESTIGATING",
        "AWAITING_APPROVAL",
        "REMEDIATING",
        "VERIFYING",
        "RESOLVED",
        "NEEDS_HUMAN",
        "REJECTED",
        "FAILED"
      ],
      "title": "IncidentStatus",
      "type": "string"
    },
    "Severity": {
      "enum": [
        "critical",
        "high",
        "warning",
        "info"
      ],
      "title": "Severity",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "alert_active": {
      "default": true,
      "title": "Alert Active",
      "type": "boolean"
    },
    "alert_count": {
      "default": 1,
      "minimum": 0,
      "title": "Alert Count",
      "type": "integer"
    },
    "environment": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:/-]+$",
      "title": "Environment",
      "type": "string"
    },
    "fingerprint": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:/-]+$",
      "title": "Fingerprint",
      "type": "string"
    },
    "first_seen": {
      "format": "date-time",
      "title": "First Seen",
      "type": "string"
    },
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "last_seen": {
      "format": "date-time",
      "title": "Last Seen",
      "type": "string"
    },
    "resolved_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Resolved At"
    },
    "service": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:/-]+$",
      "title": "Service",
      "type": "string"
    },
    "severity": {
      "$ref": "#/$defs/Severity"
    },
    "status": {
      "$ref": "#/$defs/IncidentStatus"
    },
    "summary": {
      "default": "",
      "maxLength": 4000,
      "title": "Summary",
      "type": "string"
    },
    "title": {
      "maxLength": 256,
      "title": "Title",
      "type": "string"
    },
    "version": {
      "default": 0,
      "description": "Optimistic-lock version",
      "minimum": 0,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "id",
    "fingerprint",
    "title",
    "status",
    "severity",
    "service",
    "environment",
    "first_seen",
    "last_seen"
  ],
  "title": "Incident",
  "type": "object"
}
