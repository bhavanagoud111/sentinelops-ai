# Local development defaults. Copy to .env (git-ignored) and adjust.
# Never put real credentials here — this stack only runs on 127.0.0.1.

# Shared secret for the demo-only fault admin API (X-Fault-Token header).
FAULT_ADMIN_TOKEN=local-dev-fault-token

GRAFANA_ADMIN_PASSWORD=admin
LOADGEN_RPS=8

POSTGRES_PASSWORD=sentinel
# Remediation: disabled | recommend_only | sandbox (allowlisted writes to the demo namespace).
# The platform default is recommend_only; the local demo opts into sandbox here.
REMEDIATION_MODE=sandbox
# Investigation model: rules (default, free) | claude (needs ANTHROPIC_API_KEY)
SENTINEL_LLM_PROVIDER=rules

# Dev login issues JWTs for demo identities. Disable outside local demos.
AUTH_DEV_LOGIN=true

# Host ports (all bound to 127.0.0.1)
CHECKOUT_PORT=18081
INVENTORY_PORT=18082
PROMETHEUS_PORT=19090
ALERTMANAGER_PORT=19093
GRAFANA_PORT=13000
LOKI_PORT=13100
TEMPO_PORT=13200
OTEL_GRPC_PORT=14317
OTEL_HTTP_PORT=14318
API_PORT=18000
INGESTION_PORT=18001
POSTGRES_PORT=15432
KAFKA_PORT=19092
DASHBOARD_PORT=13001
