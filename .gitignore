# Project-local tool caches (uv, managed Python, npm) — keep everything inside the repo
.cache/
.venv/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/

# Secrets / local config
.env
.env.*
!.env.example

# Editors / OS
.DS_Store
.idea/
.vscode/

# Node (Phase 5)
node_modules/
apps/dashboard/dist/
apps/dashboard/test-results/
apps/dashboard/playwright-report/

# Terraform (Phase 7) — commit .terraform.lock.hcl, never state or real tfvars
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
terraform.tfvars
crash.log
